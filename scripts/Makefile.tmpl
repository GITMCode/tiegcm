# Root Makefile — generated by config.py.  Do not edit;
# re-run  python config.py --horires <deg>  to update.

TIEGCMHOME = {tiegcmhome}
TIEGCMDATA ?= {tiegcmdata}
GSWM_RES   = {gswm_res}
STEP       = {step}
# sres=2.5/5 deg, dres=1.25/0.625 deg
HE_SUFFIX  := $(if $(filter 1.25d 0.625d,$(GSWM_RES)),dres,sres)
NAME      ?= run

.PHONY: all clean rundir

all:
	cd $(TIEGCMHOME)/build && make -j$(shell nproc) all

clean:
	cd $(TIEGCMHOME)/build && make clean

rundir:
	@if [ "$(TIEGCMDATA)" = "/path/to/tiegcmdata" ]; then \
		echo "Error: TIEGCMDATA is not set."; \
		echo "  Pass it on the command line:  make rundir TIEGCMDATA=/path/to/tiegcmdata"; \
		echo "  Or edit TIEGCMDATA in Makefile directly."; \
		exit 1; \
	fi
	mkdir -p $(NAME)
	@if [ -f $(TIEGCMHOME)/build/tiegcm.exe ]; then \
		ln -sfn $(TIEGCMHOME)/build/tiegcm.exe $(NAME)/tiegcm.exe; \
		ln -sfn $(TIEGCMDATA) $(NAME)/tiegcmdata; \
	else \
		echo "  Note: tiegcm.exe not yet built — run 'make' first"; \
	fi
	sed \
		-e "s|tiegcmdata/|$(TIEGCMDATA)/|g" \
		-e "s|_2\.5d_|_$(GSWM_RES)_|g" \
		-e "s|he_coefs_sres|he_coefs_$(HE_SUFFIX)|g" \
		-e "/^ STEP /s/= [0-9]*/= $(STEP)/" \
		$(TIEGCMHOME)/scripts/tiegcm_def_noenv.inp > $(NAME)/$(NAME).inp
	sed \
		-e "s|tiegcmdata/|$(TIEGCMDATA)/|g" \
		-e "s|_2\.5d_|_$(GSWM_RES)_|g" \
		-e "s|he_coefs_sres|he_coefs_$(HE_SUFFIX)|g" \
		-e "/^ STEP /s/= [0-9]*/= $(STEP)/" \
		$(TIEGCMHOME)/scripts/tiegcm_full_noenv.inp > $(NAME)/$(NAME)_full.inp
{ie_data_line}

	@echo ""
	@echo "'$(NAME)/'   created!"
	@echo "  At minimum, in $(NAME).inp set:"
	@echo "  - Start time (START_YEAR, START_DAY)"
	@echo "  - SOURCE     (use scripts/interpic.py to interpolate a TIEGCMDATA/source/*.nc file)"
	@echo "  - IMF_NCFILE (if using Weimer)"
