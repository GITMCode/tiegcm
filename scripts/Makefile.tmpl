# Root Makefile — generated by config.py.  Do not edit;
# re-run  python config.py --horires <deg>  to update.

TIEGCMHOME = {tiegcmhome}
TIEGCMDATA = {tiegcmdata}
GSWM_RES   = {gswm_res}
NAME      ?= run

.PHONY: all clean rundir

all:
	cd $(TIEGCMHOME)/build && make -j$(shell nproc) all

clean:
	cd $(TIEGCMHOME)/build && make clean

rundir:
	mkdir -p $(NAME)
	@if [ -f $(TIEGCMHOME)/build/tiegcm.exe ]; then \
		ln -sfn $(TIEGCMHOME)/build/tiegcm.exe $(NAME)/tiegcm.exe; \
		ln -sfn $(TIEGCMDATA) $(NAME); \
	else \
		echo "  Note: tiegcm.exe not yet built — run 'make' first"; \
	fi
	cp $(TIEGCMHOME)/scripts/tiegcm_def_noenv.inp $(NAME)/$(NAME).inp
	ln -sfn $(TIEGCMDATA)/he_coefs_sres.nc        $(NAME)/
	ln -sfn $(TIEGCMDATA)/he_coefs_dres.nc        $(NAME)/
	ln -sfn $(TIEGCMDATA)/boundary_files/GSWM/gswm_diurn_$(GSWM_RES)_99km.nc        $(NAME)/
	ln -sfn $(TIEGCMDATA)/boundary_files/GSWM/gswm_semi_$(GSWM_RES)_99km.nc         $(NAME)/
	ln -sfn $(TIEGCMDATA)/boundary_files/GSWM/gswm_nonmig_diurn_$(GSWM_RES)_99km.nc $(NAME)/
	ln -sfn $(TIEGCMDATA)/boundary_files/GSWM/gswm_nonmig_semi_$(GSWM_RES)_99km.nc  $(NAME)/
{ie_data_line}

	@echo ""
	@echo "'$(NAME)/'   created!"
	@echo "  At minimum, in $(NAME).inp set:"
	@echo "  - Start time (START_YEAR, START_DAY)"
	@echo "  - SOURCE     (use scripts/interpic.py to interpolate a TIEGCMDATA/source/*.nc file)"
	@echo "  - IMF_NCFILE (if using Weimer)"
