&tgcm_input

! Minimal TIEGCM namelist -- Heelis, constant quiet-time indices.
! Template: 'make rundir' substitutes tiegcmdata/ -> absolute TIEGCMDATA path,
!   2.5d -> configured resolution, and he_coefs_sres -> correct suffix.
! See tiegcm_full_noenv.inp for all options with documentation.

 LABEL          = 'tiegcm'
 START_YEAR     = 2002
 START_DAY      = 80
 CALENDAR_ADVANCE = 1

 SOURCE         = 'CHANGEME'
 SOURCE_START   = 80 0 0 0

 PRISTART  = 80 0 0 0
 PRISTOP   = 81 0 0 0
 PRIHIST   = 1 0 0 0
 STEP      = 30
 NSTEP_SUB = 10
 OUTPUT    = 'tiegcm_prim_001.nc'
 MXHIST_PRIM = 10

 SECSTART  = 80 1 0 0
 SECSTOP   = 81 0 0 0
 SECHIST   = 0 1 0 0
 SECOUT    = 'tiegcm_sech_001.nc'
 MXHIST_SECH = 24
 SECFLDS = 'TN' 'UN' 'VN' 'WN' 'O2' 'O1' 'N2' 'NO' 'N4S' 'HE' 'NE'
           'TE' 'TI' 'TEC' 'O2P' 'OP' 'POTEN' 'UI_ExB' 'VI_ExB'
           'WI_ExB' 'DEN' 'QJOULE' 'HMF2' 'NMF2' 'Z' 'ZG'

! Tidal boundary -- filenames are resolution-specific (2.5d template; make rundir substitutes)
 GSWM_MI_DI_NCFILE  = 'tiegcmdata/boundary_files/GSWM/gswm_diurn_2.5d_99km.nc'
 GSWM_MI_SDI_NCFILE = 'tiegcmdata/boundary_files/GSWM/gswm_semi_2.5d_99km.nc'
 GSWM_NM_DI_NCFILE  = 'tiegcmdata/boundary_files/GSWM/gswm_nonmig_diurn_2.5d_99km.nc'
 GSWM_NM_SDI_NCFILE = 'tiegcmdata/boundary_files/GSWM/gswm_nonmig_semi_2.5d_99km.nc'

! Helium -- sres=2.5deg, dres=1.25deg; must match resolution
 HE_COEFS_NCFILE = 'tiegcmdata/he_coefs_sres.nc'
 CALC_HELIUM = 1

 POTENTIAL_MODEL = 'HEELIS'
 AURORA_MODEL    = 'emery'

! Indices -- scalars; use GPI_NCFILE for time-varying F107/Kp (Kp maps to POWER/CTPOTEN)
 F107  = 70.
 F107A = 70.
 POWER   = 18.    ! hemispheric power (GW); drives emery aurora. Use POWER_TIME to vary.
 CTPOTEN = 30.    ! cross-polar cap potential (kV); Heelis only. Use CTPOTEN_TIME to vary.

! Required even when SAPS=.false. to avoid needing $TGCMDATA
 SUBAUR_DATA = 'tiegcmdata/subaur_data.nc'

/
